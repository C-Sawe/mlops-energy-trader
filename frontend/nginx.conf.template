# Rendered by the nginx image's envsubst step at container start. Only
# variables present in the environment are substituted, so nginx's own
# $uri / $host etc. are left alone.
server {
    listen 80;
    server_name _;

    # DASHBOARD_AUTH=basic: basic auth gates the whole dashboard and API;
    # the password file is written by docker-entrypoint.d/10-dashboard-auth.envsh.
    # DASHBOARD_AUTH=signin: "off", and the backend's sign-in decides.
    auth_basic ${NGINX_AUTH_BASIC};
    auth_basic_user_file /etc/nginx/.htpasswd;

    location = /healthz {
        auth_basic off;
        access_log off;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass http://backend:8000/;
        # NFR-10: in basic mode the API bearer token stays server-side; the
        # browser never sees it. The browser's own Authorization header
        # (basic auth) is replaced here, not forwarded. In signin mode this is
        # empty, so nothing is injected and the session cookie decides.
        proxy_set_header Authorization "${PROXY_AUTHORIZATION}";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # /ingest/run runs synchronously and can take a while.
        proxy_read_timeout 300s;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
