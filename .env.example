# Copy to .env and adjust. NEVER commit .env (see .gitignore).
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mlops_trading

# Chronological partition (DR-06: EVAL_START must be after TRAIN_END)
TRAIN_START=2015-01-01
TRAIN_END=2023-12-31
EVAL_START=2024-01-01
EVAL_END=2025-12-31

# Risk thresholds (FR-12, FR-14)
VIX_CRITICAL_THRESHOLD=35.0
TARGET_SHARPE_THRESHOLD=1.0
SHARPE_EVALUATION_WINDOW=30

MLFLOW_TRACKING_URI=http://localhost:5000
