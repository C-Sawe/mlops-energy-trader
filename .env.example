# Copy to .env and adjust. NEVER commit .env (see .gitignore).
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mlops_trading

# Chronological partition (DR-06: EVAL_START must be after TRAIN_END)
TRAIN_START=2015-01-01
TRAIN_END=2023-12-31
EVAL_START=2024-01-01
EVAL_END=2025-12-31

# Risk thresholds (FR-12, FR-14)
VIX_CRITICAL_THRESHOLD=35.0
TARGET_SHARPE_THRESHOLD=1.0
SHARPE_EVALUATION_WINDOW=30

MLFLOW_TRACKING_URI=http://localhost:5000

# Optional full override of the Postgres connection (IR-03). Takes precedence
# over the POSTGRES_* values above when set.
# DATABASE_URL=postgresql+psycopg2://mlops:change_me@localhost:5432/mlops_trading

# Serving (src/serving/api.py). Leave the token unset for local single-user
# operation; set it in any deployment reachable from a network.
# API_BEARER_TOKEN=
CT_EVALUATION_INTERVAL_SECONDS=300
INGESTION_INTERVAL_SECONDS=86400

# Dashboard sign-in (backend/src/serving/auth.py). Off until PASSWORD_LOGIN
# is true or a provider has both a client id and secret; then SESSION_SECRET
# and ALLOWED_EMAILS are required. Password accounts are created with
# backend/scripts/create_dashboard_user.py. Register http://localhost:8000/auth/callback/<provider>
# with each provider for local use; see docs/DEPLOYMENT.md, "Sign-in".
# SESSION_SECRET=            # openssl rand -hex 32
# ALLOWED_EMAILS=you@example.com,supervisor@example.com
# PASSWORD_LOGIN=true
# PUBLIC_API_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Alpaca PAPER trading only (CLAUDE.md §7) - used by
# scripts/broker_paper_trade_test.py. There is no live-endpoint setting.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
