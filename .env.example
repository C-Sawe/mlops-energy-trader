# Copy to .env and adjust. NEVER commit .env (see .gitignore).
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mlops_trading

# Chronological partition (DR-06: EVAL_START must be after TRAIN_END)
TRAIN_START=2015-01-01
TRAIN_END=2023-12-31
EVAL_START=2024-01-01
EVAL_END=2025-12-31

# Risk thresholds (FR-12, FR-14)
VIX_CRITICAL_THRESHOLD=35.0
TARGET_SHARPE_THRESHOLD=1.0
SHARPE_EVALUATION_WINDOW=30

MLFLOW_TRACKING_URI=http://localhost:5000

# Optional full override of the Postgres connection (IR-03). Takes precedence
# over the POSTGRES_* values above when set.
# DATABASE_URL=postgresql+psycopg2://mlops:change_me@localhost:5432/mlops_trading

# Serving (src/serving/api.py). Leave the token unset for local single-user
# operation; set it in any deployment reachable from a network.
# API_BEARER_TOKEN=
CT_EVALUATION_INTERVAL_SECONDS=300
INGESTION_INTERVAL_SECONDS=86400

# Alpaca PAPER trading only (CLAUDE.md §7) - used by
# scripts/broker_paper_trade_test.py. There is no live-endpoint setting.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
